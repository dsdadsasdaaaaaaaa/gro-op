<?xml version="1.0" encoding="utf-8"?>
<!-- Same Wi-Fi mode talks plain HTTP to the add-on on the home LAN. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
